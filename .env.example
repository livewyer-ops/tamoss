# Optional overrides for the local KIND development loop.
# Copy to .env and edit as needed; .env is git-ignored.

# Path to the KIND kubeconfig (default: ./tams.kubeconfig)
# KUBECONFIG="$(pwd)/tams.kubeconfig"

# Frontend dev-server target API (default: http://localhost:8000)
# TAMOSS_API_URL="http://localhost:8000"
