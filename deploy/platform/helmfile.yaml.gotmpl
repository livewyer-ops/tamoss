{{- $platform := .Values.platform | default dict -}}
{{- $certManager := .Values.certManager | default dict -}}
{{- $certManagerChart := index .Values "cert-manager" | default dict -}}
{{- $cnpg := .Values.cnpg | default dict -}}
{{- $rustfsOperator := .Values.rustfsOperator | default dict -}}
{{- $authentik := .Values.authentik | default dict -}}
{{- $authentikChart := .Values.authentikChart | default dict -}}
{{- $authentikGlobal := index $authentikChart "global" | default dict -}}
{{- $traefik := .Values.traefik | default dict -}}
{{- $tls := .Values.tls | default dict -}}
{{- $clusterIssuer := .Values.clusterIssuer | default dict -}}
{{- $certManagerEnabled := index $certManager "enabled" | default false -}}
{{- $cnpgEnabled := index $cnpg "enabled" | default false -}}
{{- $rustfsOperatorEnabled := index $rustfsOperator "enabled" | default false -}}
{{- $authentikEnabled := index $authentik "enabled" | default false -}}
{{- $traefikEnabled := index $traefik "enabled" | default false -}}
{{- $certManagerNamespace := default "cert-manager" (index $certManagerChart "namespace") -}}
{{- $cnpgNamespace := default "cnpg-system" (index $cnpg "namespaceOverride") -}}
{{- $rustfsNamespace := default "rustfs-system" (index $rustfsOperator "namespace") -}}
{{- $authNamespace := default (default "auth" (index $authentikGlobal "namespaceOverride")) (index $authentikChart "namespaceOverride") -}}
{{- $traefikNamespace := default "traefik" (index $traefik "namespaceOverride") -}}
{{- $configNamespace := default "tamoss-platform" (index $platform "namespace") -}}
{{- $authentikBootstrapValues := dict "authentik" $authentik "authentikChart" $authentikChart -}}
{{- $platformConfigValues := dict "authentik" $authentik "authentikChart" $authentikChart "tls" $tls "clusterIssuer" $clusterIssuer -}}

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: cloudnative-pg
    url: https://cloudnative-pg.github.io/charts
  - name: traefik
    url: https://traefik.github.io/charts
  - name: goauthentik
    url: https://charts.goauthentik.io

helmDefaults:
  createNamespace: true
  wait: true
  waitForJobs: true
  timeout: {{ index $platform "timeoutSeconds" | default 900 }}

releases:
{{- if $certManagerEnabled }}
  - name: cert-manager
    namespace: {{ $certManagerNamespace | quote }}
    chart: jetstack/cert-manager
    version: v1.20.2
    labels:
      component: cert-manager
      tier: dependency
    values:
{{ toYaml (list $certManagerChart) | nindent 6 }}
{{- end }}
{{- if $traefikEnabled }}
  - name: traefik
    namespace: {{ $traefikNamespace | quote }}
    chart: traefik/traefik
    version: 40.2.0
    labels:
      component: traefik
      tier: dependency
    values:
{{ toYaml (list $traefik) | nindent 6 }}
{{- end }}
{{- if $cnpgEnabled }}
  - name: cnpg
    namespace: {{ $cnpgNamespace | quote }}
    chart: cloudnative-pg/cloudnative-pg
    version: 0.28.2
    labels:
      component: cnpg
      tier: dependency
    values:
{{ toYaml (list $cnpg) | nindent 6 }}
{{- end }}
{{- if $rustfsOperatorEnabled }}
  - name: rustfs-operator
    namespace: {{ $rustfsNamespace | quote }}
    chart: ./charts/rustfs-operator
    labels:
      component: rustfs-operator
      tier: dependency
    values:
{{ toYaml (list $rustfsOperator) | nindent 6 }}
{{- end }}
{{- if $authentikEnabled }}
  - name: authentik-bootstrap
    namespace: {{ $authNamespace | quote }}
    chart: ./charts/authentik-bootstrap
    labels:
      component: authentik-bootstrap
      tier: dependency
    values:
{{ toYaml (list $authentikBootstrapValues) | nindent 6 }}
  - name: authentik
    namespace: {{ $authNamespace | quote }}
    chart: goauthentik/authentik
    version: 2026.2.3
    labels:
      component: authentik
      tier: dependency
    needs:
      - {{ printf "%s/authentik-bootstrap" $authNamespace | quote }}
    values:
{{ toYaml (list $authentikChart) | nindent 6 }}
{{- end }}
  - name: tamoss-platform-config
    namespace: {{ $configNamespace | quote }}
    chart: ./charts/config
    labels:
      component: platform-config
      tier: config
{{- if or $certManagerEnabled $traefikEnabled $authentikEnabled }}
    needs:
{{- if $certManagerEnabled }}
      - {{ printf "%s/cert-manager" $certManagerNamespace | quote }}
{{- end }}
{{- if $traefikEnabled }}
      - {{ printf "%s/traefik" $traefikNamespace | quote }}
{{- end }}
{{- if $authentikEnabled }}
      - {{ printf "%s/authentik" $authNamespace | quote }}
{{- end }}
{{- end }}
    values:
{{ toYaml (list $platformConfigValues) | nindent 6 }}
