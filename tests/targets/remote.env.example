TEST_TARGET=remote
TEST_TAMOSS_API=https://api.tamoss.example.com
TEST_TAMOSS_UI=https://app.tamoss.example.com
TEST_TAMOSS_AUTH=https://auth.tamoss.example.com
TEST_TAMOSS_UI_EXPECT_STATUS=302
TEST_INSECURE_SKIP_TLS_VERIFY=false
TEST_TIMEOUT_SECONDS=10

# Provide one auth method for the deployed API and UI proxy.
TEST_TAMOSS_TOKEN=
# TEST_TAMOSS_TOKEN_SECRET=tams-api-token
# TEST_TAMOSS_NAMESPACE=tams
# TEST_BASIC_AUTH_USER=tamoss
# TEST_BASIC_AUTH_PASSWORD=

# Browser UI E2E authenticates through the public UI/Auth ingress.
TEST_TAMOSS_AUTH_USER=akadmin
TEST_TAMOSS_AUTH_PASSWORD=
# TEST_TAMOSS_AUTH_PASSWORD_SECRET=tams-authentik
# TEST_TAMOSS_AUTH_PASSWORD_KEY=AUTHENTIK_BOOTSTRAP_PASSWORD
# TEST_TAMOSS_AUTH_NAMESPACE=authentik
