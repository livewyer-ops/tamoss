# TAMOSS Frontend Configuration
# Copy to .env.local for local development overrides

# Browser-facing API base URL. Leave as /api for the Vite dev-server proxy.
VITE_API_URL=/api

# Vite dev-server proxy target for /api (forwards to the FastAPI dev server).
VITE_API_TARGET=http://localhost:8000

# Bearer token sent on API requests.
# In production, set TAMOSS_API_TOKEN on the container.
VITE_API_TOKEN=dev_token
