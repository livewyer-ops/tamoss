# TAMOSS Frontend Configuration
# Export these values before running the Vite development server.

# Vite dev-server proxy target for /api (forwards to the FastAPI dev server).
VITE_API_TARGET=http://localhost:8000

# Optional bearer token added inside the Vite development proxy. It is never
# compiled into browser JavaScript. Production uses nginx forward-auth proof.
TAMOSS_DEV_API_TOKEN=dev_token
