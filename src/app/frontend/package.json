{
  "name": "tamoss-ui",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=25.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "api:types": "node scripts/generate-openapi-types.mjs",
    "api:types:check": "node scripts/generate-openapi-types.mjs --check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:all": "npm test && npm run test:entrypoint",
    "test:entrypoint": "sh tests/docker-entrypoint.test.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run api:types:check && biome check .",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "dependencies": {
    "@byomakase/omakase-player": "1.2.0",
    "@tanstack/react-query": "^5.102.8",
    "hls.js": "1.7.3",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
